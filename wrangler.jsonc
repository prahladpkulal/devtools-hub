{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devtools-hub",
  "main": "worker.js",
  "compatibility_date": "2026-09-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
